# Copy to .env and fill in. NEVER commit .env.

# PocketBase release to install — pinned, do not float on "latest".
# Check https://github.com/pocketbase/pocketbase/releases before bumping;
# the migration JS API changes between versions.
PB_VERSION=0.39.6

# Where PocketBase keeps its data, migrations and hooks.
PB_DATA_DIR=/opt/pocketbase
